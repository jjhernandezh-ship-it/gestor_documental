@page "/procesos"
@attribute [Authorize(Roles = "Administrador")]
@rendermode InteractiveServer
@inject IProcessService Service
@inject IAreaService AreasService
@inject AuthenticationStateProvider Auth

<PageTitle>Procesos</PageTitle>
<h1>Procesos</h1>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <h2 class="h5 mb-3">@(model.Id == Guid.Empty ? "Nuevo proceso" : "Modificar proceso")</h2>
        <EditForm Model="model" OnValidSubmit="Save" FormName="process-save">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" />
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Código</label>
                    <InputText class="form-control" @bind-Value="model.Code" placeholder="Ej. PDAF001" />
                </div>
                <div class="col-md-5">
                    <label class="form-label">Nombre</label>
                    <InputText class="form-control" @bind-Value="model.Name" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Área</label>
                    <InputSelect class="form-select" @bind-Value="model.AreaId">
                        <option value="">Sin área</option>
                        @foreach (var area in areas) { <option value="@area.Id">@area.Name</option> }
                    </InputSelect>
                </div>
                <div class="col-md-9">
                    <label class="form-label">Descripción</label>
                    <InputTextArea class="form-control" @bind-Value="model.Description" rows="2" />
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <div class="form-check mb-2">
                        <InputCheckbox class="form-check-input" @bind-Value="model.IsActive" />
                        <label class="form-check-label">Proceso activo</label>
                    </div>
                </div>
                <div class="col-12 d-flex gap-2">
                    <button class="btn btn-primary" disabled="@saving">@(model.Id == Guid.Empty ? "Crear" : "Guardar cambios")</button>
                    @if (model.Id != Guid.Empty) { <button type="button" class="btn btn-outline-secondary" @onclick="CancelEdit">Cancelar</button> }
                </div>
            </div>
        </EditForm>
    </div>
</div>

@if (message is not null) { <div class="alert @(isError ? "alert-danger" : "alert-success")">@message</div> }

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead><tr><th>Código</th><th>Nombre</th><th>Área</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead>
        <tbody>
        @foreach (var process in items)
        {
            <tr class="@(model.Id == process.Id ? "table-primary" : null)">
                <td>@process.Code</td><td>@process.Name</td><td>@(process.AreaName ?? "Sin área")</td>
                <td><span class="badge @(process.IsActive ? "text-bg-success" : "text-bg-secondary")">@(process.IsActive ? "Activo" : "Inactivo")</span></td>
                <td class="text-end"><button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => Edit(process)">Editar</button></td>
            </tr>
        }
        </tbody>
    </table>
</div>

@code {
    private List<ProcessDto> items = [];
    private IReadOnlyList<AreaDto> areas = [];
    private ProcessForm model = new();
    private string? message;
    private bool isError, saving;

    protected override async Task OnInitializedAsync()
    {
        areas = await AreasService.ListAsync();
        await Reload();
    }

    private void Edit(ProcessDto process)
    {
        model = new() { Id = process.Id, Code = process.Code, Name = process.Name, Description = process.Description, AreaId = process.AreaId, IsActive = process.IsActive };
        message = null;
    }

    private void CancelEdit() { model = new(); message = null; }

    private async Task Save()
    {
        saving = true; message = null;
        try
        {
            var editing = model.Id != Guid.Empty;
            var user = (await Auth.GetAuthenticationStateAsync()).User.FindFirstValue(ClaimTypes.NameIdentifier)!;
            await Service.SaveAsync(new(model.Id, model.Code, model.Name, model.Description, model.AreaId, null, model.IsActive), user);
            isError = false; message = editing ? "Proceso modificado correctamente." : "Proceso creado correctamente.";
            model = new(); await Reload();
        }
        catch (Exception ex) { isError = true; message = ex.Message; }
        finally { saving = false; }
    }

    private async Task Reload() => items = (await Service.ListAsync()).ToList();

    private sealed class ProcessForm
    {
        public Guid Id { get; set; }
        [System.ComponentModel.DataAnnotations.Required, System.ComponentModel.DataAnnotations.MaxLength(30)] public string Code { get; set; } = "";
        [System.ComponentModel.DataAnnotations.Required, System.ComponentModel.DataAnnotations.MaxLength(250)] public string Name { get; set; } = "";
        public string? Description { get; set; }
        public Guid? AreaId { get; set; }
        public bool IsActive { get; set; } = true;
    }
}
