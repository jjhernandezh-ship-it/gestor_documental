@page "/areas"
@attribute [Authorize(Roles = "Administrador")]
@rendermode InteractiveServer
@inject IAreaService Service
@inject AuthenticationStateProvider Auth

<PageTitle>Áreas</PageTitle>
<h1>Áreas</h1>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <h2 class="h5 mb-3">@(model.Id == Guid.Empty ? "Nueva área" : "Modificar área")</h2>
        <EditForm Model="model" OnValidSubmit="Save" FormName="area-save">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" />
            <div class="row g-3">
                <div class="col-md-5">
                    <label class="form-label">Nombre</label>
                    <InputText class="form-control" @bind-Value="model.Name" />
                </div>
                <div class="col-md-5">
                    <label class="form-label">Descripción</label>
                    <InputText class="form-control" @bind-Value="model.Description" />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <div class="form-check mb-2">
                        <InputCheckbox class="form-check-input" @bind-Value="model.IsActive" />
                        <label class="form-check-label">Área activa</label>
                    </div>
                </div>
                <div class="col-12 d-flex gap-2">
                    <button class="btn btn-primary" disabled="@saving">@(model.Id == Guid.Empty ? "Crear" : "Guardar cambios")</button>
                    @if (model.Id != Guid.Empty) { <button type="button" class="btn btn-outline-secondary" @onclick="CancelEdit">Cancelar</button> }
                </div>
            </div>
        </EditForm>
    </div>
</div>

@if (message is not null) { <div class="alert @(isError ? "alert-danger" : "alert-success")">@message</div> }

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead><tr><th>Nombre</th><th>Descripción</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead>
        <tbody>
        @foreach (var area in items)
        {
            <tr class="@(model.Id == area.Id ? "table-primary" : null)">
                <td>@area.Name</td><td>@area.Description</td>
                <td><span class="badge @(area.IsActive ? "text-bg-success" : "text-bg-secondary")">@(area.IsActive ? "Activa" : "Inactiva")</span></td>
                <td class="text-end"><button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => Edit(area)">Editar</button></td>
            </tr>
        }
        </tbody>
    </table>
</div>

@code {
    private List<AreaDto> items = [];
    private AreaForm model = new();
    private string? message;
    private bool isError, saving;

    protected override async Task OnInitializedAsync() => await Reload();

    private void Edit(AreaDto area)
    {
        model = new() { Id = area.Id, Name = area.Name, Description = area.Description, IsActive = area.IsActive };
        message = null;
    }

    private void CancelEdit() { model = new(); message = null; }

    private async Task Save()
    {
        saving = true; message = null;
        try
        {
            var editing = model.Id != Guid.Empty;
            var user = (await Auth.GetAuthenticationStateAsync()).User.FindFirstValue(ClaimTypes.NameIdentifier)!;
            await Service.SaveAsync(new(model.Id, model.Name, model.Description, model.IsActive), user);
            isError = false; message = editing ? "Área modificada correctamente." : "Área creada correctamente.";
            model = new(); await Reload();
        }
        catch (Exception ex) { isError = true; message = ex.Message; }
        finally { saving = false; }
    }

    private async Task Reload() => items = (await Service.ListAsync()).ToList();

    private sealed class AreaForm
    {
        public Guid Id { get; set; }
        [System.ComponentModel.DataAnnotations.Required, System.ComponentModel.DataAnnotations.MaxLength(200)] public string Name { get; set; } = "";
        public string? Description { get; set; }
        public bool IsActive { get; set; } = true;
    }
}
